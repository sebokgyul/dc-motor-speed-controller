@startuml
title Connected Motor Monitoring & Operator Assistance Demo

left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultTextAlignment center

package "Local machine-control layer" #EAF4F6 {
  component "Deterministic\nscenario generator" as Scenario
  component "Motor and\nspeed sensor" as Motor
  component "Simulated HAL\nADC / PWM / GPIO" as HAL
  component "Local PI controller\n10 ms simulated step" as Controller
  component "Local machine monitor\nsensor + stall faults" as Monitor
  component "Simulation orchestrator" as Simulation

  Scenario --> Simulation : timestamped frame
  Simulation --> HAL : target + local enable
  Simulation --> Motor : simulated load
  Motor --> HAL : measured speed
  HAL --> Controller : ADC + enable
  Controller --> HAL : bounded PWM
  HAL --> Motor : motor drive
  Controller --> Monitor : control state
  Simulation --> Monitor : operator run request\n+ fixed sample step
  Monitor ..> Simulation : local simulated\nstop request
}

component "Telemetry /\nsupervisory layer" as Telemetry #DDEBFF
component "Operator dashboard\nread-only replay" as Dashboard #E5F6E9
component "Bounded advisory\nassistant" as Assistant #FFF0CF
artifact "Approved troubleshooting\ndocumentation" as Docs #FFF8E8

Controller --> Telemetry : target / speed / PWM / state
Monitor --> Telemetry : machine state / fault / event
Telemetry --> Dashboard : JSON Lines or CSV
Telemetry --> Assistant : read-only context
Docs --> Assistant : approved content only
Assistant --> Dashboard : sourced recommendation\n+ uncertainty disclosure

note bottom of Controller
  The host program advances simulated time in fixed steps.
  A real scheduled task would remain local.
  Browser or network timing cannot affect PWM.
end note

note bottom of Assistant
  Advisory only. No path to motor actuators.
  Human confirmation is required before action.
end note

note bottom of Dashboard
  The current static demo replays telemetry
  generated by the deterministic C simulation.
end note

@enduml
